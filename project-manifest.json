{
  "schema_version": "1.1",
  "project": {
    "name": "calculator_fastapi_project",
    "display_name": "Calculator FastAPI Project",
    "type": "FastAPI REST API",
    "language": "Python",
    "framework": "FastAPI",
    "version": "1.0.0",
    "description": "A simple calculator REST API with add, subtract, multiply and divide endpoints."
  },
  "application": {
    "entrypoint": "app/main.py",
    "module": "app.main:app",
    "run_command": "uvicorn app.main:app --reload",
    "swagger_url": "http://127.0.0.1:8000/docs",
    "test_command": "pytest"
  },
  "api_endpoints": [
    {
      "method": "GET",
      "path": "/",
      "purpose": "Health/root response"
    },
    {
      "method": "POST",
      "path": "/add",
      "purpose": "Add two numbers"
    },
    {
      "method": "POST",
      "path": "/subtract",
      "purpose": "Subtract two numbers"
    },
    {
      "method": "POST",
      "path": "/multiply",
      "purpose": "Multiply two numbers"
    },
    {
      "method": "POST",
      "path": "/divide",
      "purpose": "Divide two numbers with divide-by-zero validation"
    },
    {
      "method": "POST",
      "path": "/modulus",
      "purpose": "Return the remainder after dividing the first number by the second number",
      "status": "requested_change"
    }
  ],
  "dependencies": {
    "file": "requirements.txt",
    "packages": [
      "fastapi==0.118.0",
      "uvicorn[standard]==0.37.0",
      "pytest==8.4.2",
      "httpx==0.28.1"
    ]
  },
  "git": {
    "repository_initialized": true,
    "default_branch": "master",
    "remote_name": "origin",
    "remote_url": "https://github.com/VKPveer/calculator_fastapi_project.git",
    "remote_tracking_branch": "origin/master",
    "auto_sync_hook": ".git/hooks/post-commit",
    "push_strategy": "fetch origin/master, merge remote history safely, then normal push",
    "force_push_default": false,
    "sync_scripts": [
      "git_sync_and_push.bat",
      "git_sync_and_push.ps1",
      "prepare_repo_for_push.bat",
      "prepare_repo_for_push.ps1"
    ]
  },
  "structure": {
    "source_directory": "app",
    "test_directory": "tests",
    "important_files": [
      "app/__init__.py",
      "app/main.py",
      "tests/test_main.py",
      "requirements.txt",
      ".gitignore",
      "README.md",
      "project-manifest.json",
      "git_sync_and_push.bat",
      "git_sync_and_push.ps1",
      "prepare_repo_for_push.bat",
      "prepare_repo_for_push.ps1",
      ".git/config",
      ".git/HEAD",
      ".git/hooks/post-commit"
    ]
  },
  "github_upload": {
    "include": [
      "app/",
      "tests/",
      "requirements.txt",
      ".gitignore",
      "README.md",
      "project-manifest.json",
      "git_sync_and_push.bat",
      "git_sync_and_push.ps1",
      "prepare_repo_for_push.bat",
      "prepare_repo_for_push.ps1"
    ],
    "exclude": [
      ".venv/",
      "__pycache__/",
      ".pytest_cache/",
      "*.pyc",
      ".env"
    ],
    "note": "The .git directory is local repository metadata and is normally not uploaded as repository content to GitHub."
  },
  "files": [
    "requirements.txt",
    ".git/index",
    ".git/info/exclude",
