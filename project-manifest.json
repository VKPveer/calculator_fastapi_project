  "manifest_purpose": "Test file-specific code updates and verify that only the intended project file is changed and pushed to the same path in GitHub.",
  "execution": {
    "mode": "apply_changes_and_push",
    "apply_changes": true,
    "commit_changes": true,
    "push_changes": true,
    "branch": "master",
    "remote": "origin",
    "commit_message": "feat: add modulus endpoint from project manifest"
  },
  "file_changes": [
    {
      "path": "app/main.py",
      "operation": "modify",
      "reason": "Add a visible code change so the GitHub commit shows an update to app/main.py.",
      "change_type": "append_code",
      "anchor": "end_of_file",
      "content": "\n\n@app.post(\"/modulus\")\ndef modulus(numbers: Numbers):\n    if numbers.b == 0:\n        raise HTTPException(status_code=400, detail=\"Cannot perform modulus by zero\")\n    return {\n        \"operation\": \"modulus\",\n        \"a\": numbers.a,\n        \"b\": numbers.b,\n        \"result\": numbers.a % numbers.b\n    }\n",
      "expected_result": {
        "endpoint": "POST /modulus",
        "example_input": {
          "a": 10,
          "b": 3
        },
        "example_output_result": 1
      }
    }
  ],
  "validation": {
    "must_change_only": [
      "app/main.py"
    ],
    "must_not_change": [
      "requirements.txt",
      "README.md",
      "tests/test_main.py",
      ".gitignore",
      ".git/"
    ],
    "commands": [
      "git diff --name-only",
      "git diff -- app/main.py",
      "pytest"
    ],
    "expected_git_diff_files": [
      "app/main.py"
    ]
  },
  "git_update_expectation": {
    "repository": "https://github.com/VKPveer/calculator_fastapi_project.git",
    "branch": "master",
    "expected_changed_file_on_github": "app/main.py",
    "note": "The system processing this manifest must apply file_changes before commit/push. Merely uploading this JSON will only change the manifest file itself."
  }
}