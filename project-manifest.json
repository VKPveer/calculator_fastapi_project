{
  "project_name": "calculator_fastapi_project",
  "project_type": "FastAPI",
  "language": "Python",
  "entrypoint": "app/main.py",
  "run_command": "uvicorn app.main:app --reload",
  "test_command": "pytest",
  "files": [
    "app/__init__.py",
    "app/main.py",
    "tests/test_main.py",
    "requirements.txt",
    ".gitignore",
    "README.md",
    "prepare_repo_for_push.bat",
    "prepare_repo_for_push.ps1"
  ],
  "git": {
    "remote_name": "origin",
    "remote_url": "https://github.com/VKPveer/calculator_fastapi_project.git",
    "branch": "master",
    "auto_sync_hook": ".git/hooks/post-commit",
    "push_strategy": "fetch + merge remote history + normal push (no force push)"
  }
}